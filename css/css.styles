body{background:black;color:white;font-family:Arial,sans-serif;}

.navbar{background:black;}
.navbar-brand{color:red;font-weight:bold;}
.nav-link{color:white;}
.nav-link:hover{color:red;}

.hero{background:#222;text-align:center;padding:80px;}
.hero h1{font-size:40px;}

.btn-primary{background:red;color:white;}

.movie-card{background:#333;padding:10px;margin:10px;border-radius:5px;}
.movie-card img{width:100%;height:220px;}

.form-control,.form-select{background:#444;color:white;}

footer{background:black;color:gray;text-align:center;padding:15px;}

@media(max-width:600px){
.hero h1{font-size:28px;}
}